<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sqf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sqf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="sqf_setting"
                         string="Auto Follow-Up on Sent Quotations"
                         help="Automatically schedule three follow-up activities when a quotation is sent.">
                    <field name="quotation_followup_auto_enable"/>
                    <div class="content-group" invisible="not quotation_followup_auto_enable">
                        <div class="row mt-2">
                            <label for="quotation_followup_days_1" class="col-lg-4 o_light_label"/>
                            <field name="quotation_followup_days_1"/>
                        </div>
                        <div class="row">
                            <label for="quotation_followup_days_2" class="col-lg-4 o_light_label"/>
                            <field name="quotation_followup_days_2"/>
                        </div>
                        <div class="row">
                            <label for="quotation_followup_days_3" class="col-lg-4 o_light_label"/>
                            <field name="quotation_followup_days_3"/>
                        </div>
                        <div class="row">
                            <label for="quotation_followup_activity_type_id" class="col-lg-4 o_light_label"/>
                            <field name="quotation_followup_activity_type_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
